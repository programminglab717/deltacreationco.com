# Response headers for Netlify and Cloudflare Pages (a static export can't set them itself).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Generated social and app icons are PNGs without a file extension.
/opengraph-image
  Content-Type: image/png
/:section/opengraph-image
  Content-Type: image/png
/:section/:slug/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
