# Copy to .env.local for local development. For a host that builds from Git,
# add the same variables in its build settings. These values are baked into
# the static build, so rebuild after changing them.

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical URL used for SEO (canonical tags, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://deltacreationco.com

# ─── Forms (contact form + bookings) ─────────────────────────────────────────
# Submissions are posted to a hosted form service that emails them to you.
# Formspree: https://formspree.io/f/<form id>  (leave the access key empty)
# Web3Forms: https://api.web3forms.com/submit  (set the access key)
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=

# ─── Bookings ────────────────────────────────────────────────────────────────
# Your permanent video-call link (Google Meet, Zoom…). Shown after booking
# and added to the visitor's calendar invite.
NEXT_PUBLIC_BOOKING_MEETING_URL=

# ─── Analytics (optional; leave empty to disable) ────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
