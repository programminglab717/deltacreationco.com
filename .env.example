# Copy to .env.local for local development. These values are baked into the
# static build, so rebuild after changing them.
#
# Contact form SMTP settings are NOT set here: they live in a PHP config file
# on the server (see public/api/config.example.php).

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical URL used for SEO (canonical tags, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://deltacreationco.com

# Optional: where the contact form posts (defaults to /api/contact.php).
NEXT_PUBLIC_CONTACT_ENDPOINT=

# ─── Analytics (optional; leave empty to disable) ────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
