# Copy to .env.local for local development, and add the same variables in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical URL used for SEO (canonical tags, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://deltacreationco.com

# ─── Email (Nodemailer / SMTP) ───────────────────────────────────────────────
# Contact-form enquiries are emailed to CONTACT_TO_EMAIL.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com and SMTP_PASS=<a Google App Password>.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender shown on outgoing emails. Must be allowed by your SMTP provider.
MAIL_FROM="Delta Creation Co. <hello@deltacreationco.com>"
# Your private inbox for enquiries and booking notifications.
CONTACT_TO_EMAIL=
# Reply-to address shown to visitors (defaults to the public site email).
PUBLIC_REPLY_TO=
# Send visitors an automatic "we got your message" email (true/false).
CONTACT_AUTOREPLY=true

# ─── Bookings → FocusPilot ───────────────────────────────────────────────────
# Every booked call is created as a task in FocusPilot.
FOCUSPILOT_API_KEY=
FOCUSPILOT_API_URL=https://focuspilot.online/api/v1
# Optional project/list the tasks should be created in.
FOCUSPILOT_PROJECT_ID=
# Your permanent video-call link (Google Meet, Zoom…). Included in invites.
BOOKING_MEETING_URL=
# Also email yourself each booking with a calendar file (true/false).
BOOKING_NOTIFY_OWNER=true

# ─── Analytics (optional; leave empty to disable) ────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
